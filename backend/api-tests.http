POST {{baseUrl}}/goals
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Swim 10 km in 30 days",
  "activityType": "SWIMMING",
  "goalType": "distance",
  "targetValue": 10,
  "startDate": "2026-10-19",
  "durationDays": 30
}

