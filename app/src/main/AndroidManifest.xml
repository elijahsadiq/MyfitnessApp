<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Phase 8a — geolocation.
      Fine + coarse location are both requested at runtime; the engine
      asks for FINE and gracefully degrades to COARSE if the user grants
      only "approximate" on API 31+. We deliberately do NOT declare
      ACCESS_BACKGROUND_LOCATION: tracking happens with the screen on
      OR with our own foreground service, which lifts the background
      requirement and avoids a much stricter Play Store review.
      FOREGROUND_SERVICE_LOCATION is required from API 34 onwards for a
      "location" service type (declared on the service node itself).
      POST_NOTIFICATIONS is API 33+ runtime permission for the ongoing
      tracking notification — treated as non-fatal in-app.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".FitnessApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyFitnessApp">

        <!--
          LAUNCHER is a tiny "router" activity: it reads TokenStore +
          OnboardingStore and starts either AuthActivity or MainActivity.
          Neither of those is exported as LAUNCHER themselves so the
          decision always goes through LauncherActivity.
        -->
        <activity
            android:name=".ui.launcher.LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.MyFitnessApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:theme="@style/Theme.MyFitnessApp" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MyFitnessApp" />
    </application>

</manifest>
