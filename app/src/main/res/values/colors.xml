<?xml version="1.0" encoding="utf-8"?>
<!--
  Kinetic Glow Fitness palette.
  Single accent (electric lime). Warm off-white canvas, pure-white cards,
  dark hero surfaces for telemetry. Sources: docs/design/kinetic_glow_fitness/DESIGN.md
  frontmatter, cross-checked against the Tailwind config in the exported
  home_dashboard/history_screen HTML.
-->
<resources>
    <!-- Neutrals -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- Semantic surface palette -->
    <color name="background_warm">#F9FAF6</color>          <!-- canvas -->
    <color name="surface_white">#FFFFFF</color>            <!-- resting cards, inputs -->
    <color name="surface_container_low">#F3F4F0</color>    <!-- row icon tiles -->
    <color name="surface_container">#EDEEEA</color>        <!-- soft chip bg -->
    <color name="surface_container_high">#E7E9E5</color>   <!-- section bg, pills -->
    <color name="surface_container_highest">#E2E3DF</color><!-- deepest tonal container -->
    <color name="surface_dark">#121411</color>             <!-- Home hero, week-strip active pill -->
    <color name="surface_charcoal">#1C1F1A</color>         <!-- alt dark surface (DESIGN.md prose) -->
    <color name="inverse_surface">#2E312F</color>          <!-- History "Weekly momentum" card -->

    <!-- Semantic text palette -->
    <color name="text_primary">#1A1C1A</color>             <!-- on light -->
    <color name="text_secondary">#5D5F5B</color>           <!-- muted/meta -->
    <color name="text_on_lime">#111410</color>             <!-- strict: text on #D4F26A only -->
    <color name="text_on_dark">#FFFFFF</color>             <!-- on charcoal/dark hero -->
    <color name="text_on_dark_muted">#E2E3DF</color>       <!-- units on dark hero -->

    <!-- Semantic structural palette -->
    <color name="divider">#E4E6E0</color>                  <!-- hairline card border -->
    <color name="outline">#767965</color>                  <!-- M3 outline role -->
    <color name="outline_variant">#C6C8B2</color>          <!-- M3 outline-variant role -->

    <!-- Accent (single) -->
    <color name="lime_accent">#D4F26A</color>              <!-- primary CTA, FAB, active pill -->
    <color name="lime_dim">#B6D24E</color>                 <!-- pressed state / dim -->
    <color name="lime_deep">#536600</color>                <!-- M3 colorPrimary role -->
    <color name="on_lime_deep">#5A6E00</color>             <!-- on-primary-container M3 role -->

    <!-- Functional validation -->
    <color name="error_red">#D64545</color>                <!-- form validation per DESIGN.md prose -->
    <color name="error_material">#BA1A1A</color>           <!-- M3 colorError role -->
    <color name="destructive">#B42318</color>              <!-- Delete button on Manage sheet (Goals v2 Step 7) -->
    <color name="destructive_container">#FDECEA</color>    <!-- Pale pink behind the trash icon on the confirm dialog -->

    <!-- Goals v2 — main-card chrome (Main.dc.html). -->
    <color name="goal_main_card">#1C1F1A</color>           <!-- 26dp dark card -->
    <color name="goal_main_pill">#2E332B</color>           <!-- "Main goal" + days-left pills -->
    <color name="goal_main_ring_track">#353A32</color>     <!-- 108dp ring track -->
    <color name="goal_main_muted">#B4B9AE</color>          <!-- "/ 50 km" + "DONE" caption -->
    <!-- Goals v2 — ended-row chrome (dashed border, lighter fill). -->
    <color name="goal_ended_fill">#FAFBF8</color>
    <color name="goal_ended_stroke">#D3D6CD</color>
    <color name="goal_ended_title">#3A3F36</color>
    <color name="goal_ended_icon_tile">#EEF0E9</color>
    <color name="goal_ended_icon_tint">#5D6257</color>
    <!-- Goals v2 — try-again outlined pill. -->
    <color name="goal_try_again_stroke">#C9CDC2</color>
    <color name="on_error">#FFFFFF</color>
    <color name="error_container">#FFDAD6</color>
    <color name="on_error_container">#93000A</color>

    <!-- Onboarding-specific (dark-screen chrome only) -->
    <color name="onboarding_dot_inactive">#2A2E27</color>  <!-- inactive page-indicator dots on surface_dark -->
    <color name="onboarding_text_muted">#8E9489</color>    <!-- body copy on hero-tinted dark surfaces -->

    <!--
      Phase 8c step 3 — dark route map tokens. Values straight from the
      brief. The `map_*` colours are the targets the ColorMatrix on the
      MAPNIK tile overlay aims for; the overlay colours sit on top of
      the darkened tiles.
    -->
    <color name="map_background">#0C0E0B</color>       <!-- dark land -->
    <color name="map_minor_road">#1A1D18</color>
    <color name="map_major_road">#272B24</color>
    <color name="map_water">#0E1A1F</color>
    <color name="map_park">#121811</color>

    <color name="map_overlay_pill">#121411</color>     <!-- used at 88 % alpha in drawable -->
    <color name="map_overlay_pill_border">#2E332B</color>

    <color name="tracking_panel">#121411</color>
    <color name="tracking_panel_border">#23271F</color>
    <color name="tracking_panel_button">#2A2E27</color>
    <!-- Lock overlay over the live map: map_background at 80 % alpha. -->
    <color name="tracking_lock_scrim">#CC0C0E0B</color>
</resources>
