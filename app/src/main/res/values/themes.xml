<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Kinetic Glow Fitness — light-only theme.

      The design is fundamentally light with dark hero surfaces layered on top.
      There is no values-night; FitnessApp calls
      AppCompatDelegate.setDefaultNightMode(MODE_NIGHT_NO) so system dark
      mode never flips us to a night resource we don't have.
    -->
    <style name="Theme.MyFitnessApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary role holds the deep-green surface tint (M3 wants a dark hue
             here; the lime is exposed on primaryContainer, matching the HTML export). -->
        <item name="colorPrimary">@color/lime_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/lime_accent</item>
        <item name="colorOnPrimaryContainer">@color/text_on_lime</item>

        <!-- Secondary + tertiary aren't heavily used; align with the design's greys. -->
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/surface_container_high</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <item name="colorTertiary">@color/text_secondary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/surface_container_high</item>
        <item name="colorOnTertiaryContainer">@color/text_primary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/background_warm</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_container</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>

        <!-- Inverse surface = the dark "Weekly momentum" card in History -->
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/text_on_dark</item>

        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="colorError">@color/error_material</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <!-- Status bar: warm canvas with dark icons. -->
        <item name="android:statusBarColor">@color/background_warm</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Type: applied via TextAppearance.Fitness.* per-widget. The
             theme-level family handles system components (Toolbar title,
             Snackbar text, dialog titles, chip labels, tab labels, etc.)
             that don't go through our own text appearances. -->
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>

        <!--
          Phase 8b — override every Material 3 type-scale slot to resolve
          to a Fitness.* appearance. Material widgets look up these
          attributes for their own text (Snackbar body, dialog title,
          chip label, etc.), so overriding them here is what makes the
          font land on components we don't style ourselves.
        -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Fitness.DisplayMetric</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Fitness.DisplayMetric</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Fitness.HeadlineLg</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Fitness.HeadlineLg</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Fitness.HeadlineLg</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Fitness.HeadlineSm</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Fitness.HeadlineSm</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Fitness.HeadlineSm</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Fitness.LabelMd</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Fitness.BodyLg</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Fitness.BodyMd</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Fitness.BodyMd</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Fitness.Button</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Fitness.LabelMd</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Fitness.LabelSm</item>
    </style>
</resources>
