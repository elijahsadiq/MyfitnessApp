    <dimen name="button_pill_height">52dp</dimen>
    <dimen name="fab_size">56dp</dimen>
    <dimen name="icon_tile_size">44dp</dimen>
    <dimen name="icon_default">24dp</dimen>
    <dimen name="icon_bottom_nav">22dp</dimen>

    <!-- Row / card internal -->
    <dimen name="card_padding">16dp</dimen>
    <dimen name="card_padding_lg">20dp</dimen>
    <dimen name="row_min_height">56dp</dimen>
    <dimen name="row_padding_h">16dp</dimen>
    <dimen name="row_padding_v">12dp</dimen>
    <dimen name="stroke_hairline">1dp</dimen>
    <dimen name="profile_avatar_size">96dp</dimen>
    <dimen name="chart_default_height">180dp</dimen>
    <dimen name="chart_label_size">11sp</dimen>
    <dimen name="chart_value_size">11sp</dimen>
    <dimen name="chart_bar_corner">6dp</dimen>

    <!-- Bottom-nav & FAB -->
