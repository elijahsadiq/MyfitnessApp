    <dimen name="fab_margin_end">16dp</dimen>
    <!--
      Bottom padding for a scrolling list that has a FAB floating over its
      end: FAB 56 + 16 margin + 16 breathing room, so the last row can be
      scrolled fully clear of the FAB.
    -->
    <dimen name="fab_clearance">88dp</dimen>

    <!-- Onboarding page indicator -->
    <dimen name="page_indicator_dot_size">6dp</dimen>
    <dimen name="page_indicator_active_width">24dp</dimen>
    <dimen name="page_indicator_gap">8dp</dimen>

    <!-- Onboarding chrome -->
    <dimen name="onboarding_arrow_size">56dp</dimen>

    <!-- Home calendar (week strip that pulls down into a month) -->
