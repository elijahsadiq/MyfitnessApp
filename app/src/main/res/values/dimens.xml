    <dimen name="activity_card_goal_icon_tile">52dp</dimen>
    <dimen name="activity_card_goal_icon_tile_radius">16dp</dimen>
    <dimen name="activity_card_goal_icon">26dp</dimen>
    <dimen name="activity_card_goal_name_text">22sp</dimen>
    <dimen name="activity_card_goal_description_text">13sp</dimen>
    <dimen name="activity_card_goal_content_gap">6dp</dimen>
    <dimen name="activity_card_goal_gap">12dp</dimen>

