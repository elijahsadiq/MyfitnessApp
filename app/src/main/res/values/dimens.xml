    <dimen name="goal_try_again_padding_horizontal">14dp</dimen>
    <dimen name="goal_try_again_touch_inset">6dp</dimen>
    <dimen name="goal_try_again_touch_overlap">-6dp</dimen>
    <!-- Goal rows: the 22dp activity icon in its tile, 2dp above a caption. -->
    <dimen name="goal_row_icon">22dp</dimen>
    <dimen name="goal_row_caption_gap">2dp</dimen>
    <!-- Ended goal row: 14dp above and below (the Try again target overlaps 6dp of it). -->
