<?xml version="1.0" encoding="utf-8"?>
<!--
  Kinetic Glow reusable component styles. Every layout in the app reads
  from these instead of hardcoding colours / radii / sizes.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Shape appearances -->
    <style name="ShapeAppearance.Fitness.Card" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.Fitness.Row" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_row</item>
    </style>

    <style name="ShapeAppearance.Fitness.TextField" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_text_field</item>
    </style>

    <style name="ShapeAppearance.Fitness.Pill" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Fitness.IconTile" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_icon_tile</item>
    </style>

    <!-- Primary CTA — lime pill -->
    <style name="Widget.Fitness.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_pill_height</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="backgroundTint">@color/lime_accent</item>
        <item name="android:textColor">@color/text_on_lime</item>
        <item name="iconTint">@color/text_on_lime</item>
        <item name="rippleColor">@color/lime_dim</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fitness.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.Button</item>
    </style>

    <!-- Ghost / secondary — white pill with 1dp divider border -->
    <style name="Widget.Fitness.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_pill_height</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="backgroundTint">@color/surface_white</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="rippleColor">@color/surface_container_high</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fitness.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.Button</item>
    </style>

    <!-- Text link button -->
    <style name="Widget.Fitness.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.Button</item>
    </style>

    <!-- Card: white surface, 24dp radius, no elevation, 1dp divider stroke. -->
    <style name="Widget.Fitness.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Card</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- Dark hero card (Home telemetry). -->
    <style name="Widget.Fitness.Card.Dark" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Card</item>
        <item name="contentPadding">@dimen/space_xl</item>
    </style>

    <!-- Inverse card (History weekly-momentum). -->
    <style name="Widget.Fitness.Card.Inverse" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/inverse_surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Card</item>
        <item name="contentPadding">@dimen/space_lg</item>
    </style>

    <!-- Filter chip: white default, lime when selected. -->
    <style name="Widget.Fitness.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">40dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/stroke_hairline</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="rippleColor">@color/lime_dim</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.LabelMd</item>
        <item name="checkedIconEnabled">false</item>
        <item name="closeIconEnabled">false</item>
    </style>

    <!-- Text input: 16dp radius white pill-ish field with a 1dp divider stroke. -->
    <style name="Widget.Fitness.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_text_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_text_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_text_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_text_field</item>
        <item name="boxBackgroundColor">@color/surface_white</item>
        <item name="boxBackgroundMode">outline</item>
        <!-- Focused outline + focused label both use `text_primary` so no
             lime shows up on a light surface (phase 8c step 1). -->
        <item name="boxStrokeColor">@color/text_field_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_hairline</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxStrokeErrorColor">@color/error_red</item>
        <item name="hintTextColor">@color/text_primary</item>
        <item name="errorTextColor">@color/error_red</item>
    </style>

    <!--
      Phase 8c step 1 — Theme overlays applied via the `materialAlertDialogTheme`,
      `materialCalendarTheme` and `materialTimePickerTheme` theme attrs on
      `Theme.MyFitnessApp`. Each one locally sets `colorPrimary` to the
      dark hue so the picker's header + accent chrome paints `#111410`
      rather than lime. The rest of the overlay inherits from the base
      Material 3 theme untouched.
    -->
    <style name="ThemeOverlay.Fitness.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.Fitness.MaterialDatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.Fitness.MaterialTimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/text_primary</item>
    </style>

    <!-- Icon tile: 44x44 squircle, surface-container-low fill. -->
    <style name="Widget.Fitness.IconTile" parent="">
        <item name="android:layout_width">@dimen/icon_tile_size</item>
        <item name="android:layout_height">@dimen/icon_tile_size</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_icon_tile</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <!-- FAB: lime, 56dp circle, icon in text_on_lime. -->
    <style name="Widget.Fitness.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/lime_accent</item>
        <item name="tint">@color/text_on_lime</item>
        <item name="rippleColor">@color/lime_dim</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Pill</item>
    </style>

    <!-- Bottom nav: lime pill behind active icon. -->
    <style name="Widget.Fitness.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface_white</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Fitness.BottomNav.ActiveIndicator</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Fitness.LabelMd</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Fitness.LabelMd</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Fitness.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/lime_accent</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Pill</item>
    </style>
</resources>
