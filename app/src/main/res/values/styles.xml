<?xml version="1.0" encoding="utf-8"?>
<!--
  Kinetic Glow reusable component styles. Every layout in the app reads
  from these instead of hardcoding colours / radii / sizes.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Shape appearances -->
    <style name="ShapeAppearance.Fitness.Card" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.Fitness.Row" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_row</item>
    </style>

    <style name="ShapeAppearance.Fitness.TextField" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_text_field</item>
    </style>

    <style name="ShapeAppearance.Fitness.Pill" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Fitness.IconTile" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_icon_tile</item>
    </style>

    <!-- Primary CTA — lime pill -->
    <style name="Widget.Fitness.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_pill_height</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="backgroundTint">@color/lime_accent</item>
        <item name="android:textColor">@color/text_on_lime</item>
        <item name="iconTint">@color/text_on_lime</item>
        <item name="rippleColor">@color/lime_dim</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fitness.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.Button</item>
        <!-- Set on the widget itself: AppCompat lets the theme's default
             font override a weight that only comes from textAppearance. -->
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>

    <!-- Ghost / secondary — white pill with 1dp divider border -->
    <style name="Widget.Fitness.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_pill_height</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="backgroundTint">@color/surface_white</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="rippleColor">@color/surface_container_high</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Fitness.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.Button</item>
        <!-- Set on the widget itself: AppCompat lets the theme's default
             font override a weight that only comes from textAppearance. -->
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>

    <!--
      Header row at the top of every main tab (Home, History, Progress,
      Goals). Same top gap, same height, same side margins everywhere so
      the title never jumps when switching tabs.
    -->
    <style name="Widget.Fitness.ScreenHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_lg</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/screen_margin</item>
        <item name="android:paddingEnd">@dimen/screen_margin</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- The large title inside Widget.Fitness.ScreenHeader. -->
    <style name="Widget.Fitness.ScreenTitle" parent="TextAppearance.Fitness.HeadlineLg">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:accessibilityHeading" tools:ignore="NewApi">true</item>
    </style>

    <!--
      Home hero numbers ("3 workouts", "2148 kcal"). Number + unit live in
      one TextView (see MetricText) so uniform auto-size can shrink the
      pair on 360dp phones / large fonts instead of clipping the unit.
    -->
    <style name="Widget.Fitness.HeroMetricValue" parent="TextAppearance.Fitness.DisplayMetric">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0sp</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">18sp</item>
        <item name="autoSizeMaxTextSize">40sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- Thin indeterminate bar overlaid on the top edge of a screen while
         it refreshes. Overlaid, never stacked, so content doesn't shift. -->
    <style name="Widget.Fitness.TopLoadingBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">top</item>
        <item name="android:indeterminate">true</item>
        <item name="android:visibility">gone</item>
        <item name="indicatorColor">@color/text_primary</item>
        <item name="trackColor">@color/surface_container_high</item>
    </style>

    <!--
      Every bottom sheet: white, 28dp top corners (the root layouts no
      longer paint a square white background over them), drawn behind the
      navigation bar with its content padded clear of it — no grey strip
      under the sheet.
    -->
    <style name="ThemeOverlay.Fitness.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Widget.Fitness.BottomSheet</item>
    </style>

    <style name="Widget.Fitness.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.BottomSheet</item>
        <item name="paddingBottomSystemWindowInsets">true</item>
    </style>

    <style name="ShapeAppearance.Fitness.BottomSheet" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_bottom_sheet_top</item>
        <item name="cornerSizeTopRight">@dimen/radius_bottom_sheet_top</item>
    </style>

    <!-- Shared toolbar on secondary screens (Profile, log forms). -->
    <style name="Widget.Fitness.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background_warm</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Fitness.ScreenTitleSm</item>
    </style>

    <!-- Text link button -->
    <style name="Widget.Fitness.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.Button</item>
        <!-- Set on the widget itself: AppCompat lets the theme's default
             font override a weight that only comes from textAppearance. -->
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>

    <!-- One segment of a MaterialButtonToggleGroup (Week / Month / Year).
         Selected = lime fill, like a selected chip. -->
    <style name="Widget.Fitness.Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="rippleColor">@color/lime_dim</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.LabelMd</item>
        <!-- Set on the widget itself: AppCompat lets the theme's default
             font override a weight that only comes from textAppearance. -->
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>

    <!-- Card: white surface, 24dp radius, no elevation, 1dp divider stroke. -->
    <style name="Widget.Fitness.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Card</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- Dark hero card (Home telemetry). -->
    <style name="Widget.Fitness.Card.Dark" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Card</item>
        <item name="contentPadding">@dimen/space_xl</item>
    </style>

    <!-- Inverse card (History weekly-momentum). -->
    <style name="Widget.Fitness.Card.Inverse" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/inverse_surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Card</item>
        <item name="contentPadding">@dimen/space_lg</item>
    </style>

    <!-- Filter chip: white default, lime when selected. -->
    <style name="Widget.Fitness.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">40dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/stroke_hairline</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="rippleColor">@color/lime_dim</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.LabelMd</item>
        <!-- `*Visible` are the attributes Material reads from a style
             (`*Enabled` only work as XML attributes on the view). -->
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
    </style>

    <!-- Text input: 16dp radius white pill-ish field with a 1dp divider stroke. -->
    <style name="Widget.Fitness.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_text_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_text_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_text_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_text_field</item>
        <item name="boxBackgroundColor">@color/surface_white</item>
        <item name="boxBackgroundMode">outline</item>
        <!-- Focused outline + focused label both use `text_primary` so no
             lime shows up on a light surface (phase 8c step 1). -->
        <item name="boxStrokeColor">@color/text_field_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_hairline</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxStrokeErrorColor">@color/error_red</item>
        <item name="hintTextColor">@color/text_primary</item>
        <item name="errorTextColor">@color/error_red</item>
        <!-- Dark cursor: lime is never a thin line on a light surface. -->
        <item name="cursorColor">@color/text_primary</item>
        <item name="cursorErrorColor">@color/error_red</item>
    </style>

    <!--
      Phase 8c step 1 — Theme overlays applied via the `materialAlertDialogTheme`,
      `materialCalendarTheme` and `materialTimePickerTheme` theme attrs on
      `Theme.MyFitnessApp`. Each one locally sets `colorPrimary` to the
      dark hue so the picker's header + accent chrome paints `#111410`
      rather than lime. The rest of the overlay inherits from the base
      Material 3 theme untouched.
    -->
    <style name="ThemeOverlay.Fitness.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/text_primary</item>
        <!-- Brand dialogs are white cards, like every other card (M3
             would paint them surface-container-high grey). -->
        <item name="colorSurfaceContainerHigh">@color/surface_white</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Fitness.Title</item>
    </style>

    <style name="MaterialAlertDialog.Fitness.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Fitness.ScreenTitleSm</item>
        <item name="android:textColor">@color/text_primary</item>
        <!-- Set on the widget itself: AppCompat lets the theme's default
             font override a weight that only comes from textAppearance. -->
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
    </style>

    <style name="ThemeOverlay.Fitness.MaterialDatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.Fitness.MaterialTimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorAccent">@color/text_primary</item>
    </style>

    <!--
      "© OpenStreetMap contributors" credit drawn over every map. A plain
      sibling of the MapView in each layout — never a child of the
      MapView itself (osmdroid crashes laying out children that carry no
      geo-point).
    -->
    <style name="Widget.Fitness.MapAttribution" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_map_attribution</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">@string/map_attribution_osm</item>
        <item name="android:textColor">@color/text_on_dark_muted</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Round 48dp icon button floating over a dark map (minimise,
         re-centre, close). -->
    <style name="Widget.Fitness.MapOverlayButton" parent="">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:background">@drawable/bg_tracking_overlay_pill</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/text_on_dark</item>
    </style>

    <!--
      One live-tracking stat value ("4.12 km", "5:52 /km", "288 kcal").
      Fixed height + uniform auto-size so the value shrinks instead of
      clipping on 360dp phones or with a large system font.
    -->
    <style name="Widget.Fitness.TrackingStatValue" parent="TextAppearance.Fitness.DisplayMetric">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0sp</item>
        <item name="android:textSize">24sp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">24sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- A value in the manual-log summary card ("5:30 /km"). Same
         auto-size approach as Widget.Fitness.TrackingStatValue. -->
    <style name="Widget.Fitness.SummaryStatValue" parent="TextAppearance.Fitness.DisplayMetric">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0sp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">26sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- ================= Log-form building blocks =================
         Shared by the run / ride form and the weightlifting form so both
         read as one design. -->

    <!-- Section title above a form card ("When", "How long?", "Sets"). -->
    <style name="Widget.Fitness.FormSectionTitle" parent="TextAppearance.Fitness.HeadlineSm">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:accessibilityHeading" tools:ignore="NewApi">true</item>
    </style>

    <!-- Tappable Date / Start-time card. -->
    <style name="Widget.Fitness.WhenCard" parent="">
        <item name="android:layout_width">0dp</item>
        <!-- match_parent inside a wrap_content row: both cards take the
             taller one's height when a value wraps (large fonts). -->
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/bg_log_when_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">@dimen/space_sm</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
    </style>

    <style name="Widget.Fitness.WhenCardValue" parent="TextAppearance.Fitness.LabelMd">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Inline validation message under a form card. -->
    <style name="Widget.Fitness.FormError" parent="TextAppearance.Fitness.LabelMd">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textColor">@color/error_material</item>
        <item name="android:visibility">gone</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>

    <!-- One big hours / minutes / seconds box. -->
    <style name="Widget.Fitness.DurationCell" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/bg_log_duration_cell</item>
        <item name="android:gravity">center</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLines">1</item>
        <!-- Both attributes: AppCompat prefers the app-namespace font, and
             the theme sets that one to the regular family. -->
        <item name="android:fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">34sp</item>
        <item name="android:hint">@string/log_duration_hint</item>
        <item name="android:textColorHint">@color/outline_variant</item>
    </style>

    <style name="Widget.Fitness.DurationCellLabel" parent="TextAppearance.Fitness.LabelMd">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.Fitness.DurationColon" parent="TextAppearance.Fitness.DisplayMetric">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="android:text">:</item>
        <item name="android:textColor">@color/goal_main_muted</item>
        <item name="android:textSize">28sp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Bar holding a form's main button, pinned to the bottom of the
         screen (thumb reach). The fragment adds the nav-bar / keyboard
         inset to its bottom padding. -->
    <style name="Widget.Fitness.PinnedButtonBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/background_warm</item>
        <item name="android:paddingStart">@dimen/screen_margin</item>
        <item name="android:paddingEnd">@dimen/screen_margin</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_lg</item>
    </style>

    <!-- Icon tile: 44x44 squircle, surface-container-low fill. -->
    <style name="Widget.Fitness.IconTile" parent="">
        <item name="android:layout_width">@dimen/icon_tile_size</item>
        <item name="android:layout_height">@dimen/icon_tile_size</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_icon_tile</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <!-- FAB: lime, 56dp circle, icon in text_on_lime. -->
    <style name="Widget.Fitness.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/lime_accent</item>
        <item name="tint">@color/text_on_lime</item>
        <item name="rippleColor">@color/lime_dim</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Pill</item>
    </style>

    <!-- Bottom nav: lime pill behind active icon. -->
    <style name="Widget.Fitness.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface_white</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Fitness.BottomNav.ActiveIndicator</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Fitness.LabelMd</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Fitness.LabelMd</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Fitness.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/lime_accent</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Pill</item>
    </style>

    <!--
      Snackbars ("toasts"). Wired up at theme level (snackbarStyle /
      snackbarTextViewStyle / snackbarButtonStyle) so every Snackbar in
      the app gets them, including ones built with Snackbar.make().
      Dark hero surface, 20dp row radius, white Plus Jakarta body, lime
      action. The leading status badge (success / error / info) comes
      from ui/base/FitnessSnackbar.kt.
    -->
    <style name="Widget.Fitness.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/surface_dark</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Fitness.Snackbar</item>
        <item name="android:layout_margin">@dimen/space_lg</item>
        <item name="actionTextColorAlpha">1</item>
        <item name="animationMode">slide</item>
    </style>

    <style name="ShapeAppearance.Fitness.Snackbar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_row</item>
    </style>

    <style name="Widget.Fitness.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:alpha">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.BodyMd</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:maxLines">3</item>
    </style>

    <style name="Widget.Fitness.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/lime_accent</item>
        <item name="android:textAppearance">@style/TextAppearance.Fitness.Button</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/lime_ripple</item>
    </style>
</resources>
