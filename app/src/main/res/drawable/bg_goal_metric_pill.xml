<?xml version="1.0" encoding="utf-8"?>
<!--
  Tracking-option pill. Selected = dark #111410 with matching border;
  unselected = white with hairline divider.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_primary" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_white" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>
</selector>
