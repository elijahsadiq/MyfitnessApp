<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark overlay pill used by the GPS status label, the minimise button
  and the re-centre button on top of the live-tracking map. Matches
  the design's `rgba(18, 20, 17, 0.88)` + 1dp `#2E332B` border.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E0121411" />
    <corners android:radius="999dp" />
    <stroke android:width="1dp" android:color="@color/map_overlay_pill_border" />
</shape>
