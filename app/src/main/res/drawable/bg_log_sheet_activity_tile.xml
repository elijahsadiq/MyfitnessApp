<?xml version="1.0" encoding="utf-8"?>
<!--
  Activity selector tile for the Log-a-workout sheet. Selected = dark
  `surface_dark` with a dark border; unselected = `background_warm`
  with the standard divider border.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_dark" />
            <corners android:radius="@dimen/radius_row" />
            <stroke android:width="1dp" android:color="@color/surface_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_warm" />
            <corners android:radius="@dimen/radius_row" />
            <stroke android:width="1dp" android:color="@color/divider" />
        </shape>
    </item>
</selector>
