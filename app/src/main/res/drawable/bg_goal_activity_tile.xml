<?xml version="1.0" encoding="utf-8"?>
<!--
  Activity-selector tile background. Selected = dark #121411 with a 1dp
  dark edge; unselected = white with the standard 1dp divider.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_dark" />
            <corners android:radius="@dimen/radius_row" />
            <stroke
                android:width="1dp"
                android:color="@color/surface_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_white" />
            <corners android:radius="@dimen/radius_row" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>
</selector>
