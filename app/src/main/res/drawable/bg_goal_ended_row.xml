<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed border + lighter fill for an "Ended" goal row (Goals v2). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/goal_ended_fill" />
    <corners android:radius="@dimen/radius_row" />
    <stroke
        android:width="1dp"
        android:color="@color/goal_ended_stroke"
        android:dashGap="3dp"
        android:dashWidth="4dp" />
</shape>
