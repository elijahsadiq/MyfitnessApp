<?xml version="1.0" encoding="utf-8"?>
<!--
  "Try again" on an ended goal row: a white 36dp pill with a hairline
  stroke, drawn inside a 48dp touch target (the view is 48dp tall; the
  6dp insets above and below stay transparent). The ripple is masked to
  the pill, so the press shows on the pill only.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/goal_try_again_touch_inset"
    android:insetBottom="@dimen/goal_try_again_touch_inset">
    <ripple android:color="?android:attr/colorControlHighlight">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="@color/surface_white" />
                <corners android:radius="@dimen/goal_try_again_radius" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/surface_white" />
                <corners android:radius="@dimen/goal_try_again_radius" />
                <stroke
                    android:width="@dimen/stroke_hairline"
                    android:color="@color/goal_try_again_stroke" />
            </shape>
        </item>
    </ripple>
</inset>
