<?xml version="1.0" encoding="utf-8"?>
<!--
  Live-tracking bottom panel. Only the top corners are rounded; the
  bottom edges meet the window / gesture bar.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tracking_panel" />
    <corners
        android:topLeftRadius="28dp"
        android:topRightRadius="28dp" />
    <!-- Top-only border: fake it with a 1dp stroke on all four sides;
         the bottom + sides are hidden by the window edge anyway. -->
    <stroke android:width="1dp" android:color="@color/tracking_panel_border" />
</shape>
