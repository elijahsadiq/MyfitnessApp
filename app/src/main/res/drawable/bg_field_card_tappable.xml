<?xml version="1.0" encoding="utf-8"?>
<!-- bg_field_card with a ripple kept inside its rounded corners (Date / Start time). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/surface_container_high">
    <item android:drawable="@drawable/bg_field_card" />
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/field_card_radius" />
        </shape>
    </item>
</ripple>
