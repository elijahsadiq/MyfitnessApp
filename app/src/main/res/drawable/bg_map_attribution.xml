<?xml version="1.0" encoding="utf-8"?>
<!--
  Small pill behind the OpenStreetMap attribution label. Mandated by
  the OSM tile licence to be legible on top of the map tiles — a dim
  dark pill fits both the design and the licence.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E0121411" /> <!-- #121411 at ~88 % alpha -->
    <corners android:radius="999dp" />
    <stroke
        android:width="1dp"
        android:color="@color/map_overlay_pill_border" />
</shape>
