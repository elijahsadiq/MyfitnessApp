<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.elijah.fitness.ui.dashboard.DashboardFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_home_to_choose_activity"
            app:destination="@id/chooseActivityBottomSheet" />
    </fragment>

    <fragment
        android:id="@+id/workoutHistoryFragment"
        android:name="com.elijah.fitness.ui.history.WorkoutHistoryFragment"
        android:label="@string/nav_history"
        tools:layout="@layout/fragment_workout_history">
        <action
            android:id="@+id/action_history_to_choose_activity"
            app:destination="@id/chooseActivityBottomSheet" />
        <action
            android:id="@+id/action_history_to_detail"
            app:destination="@id/workoutDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/workoutDetailFragment"
        android:name="com.elijah.fitness.ui.history.WorkoutDetailFragment"
        android:label="@string/detail_title_running"
        tools:layout="@layout/fragment_workout_detail">
        <argument
            android:name="clientUuid"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/progressFragment"
        android:name="com.elijah.fitness.ui.progress.ProgressFragment"
        android:label="@string/nav_progress"
        tools:layout="@layout/fragment_progress" />

    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.elijah.fitness.ui.goals.GoalsFragment"
        android:label="@string/nav_goals"
        tools:layout="@layout/fragment_goals">
        <action
            android:id="@+id/action_goals_to_new_goal"
            app:destination="@id/newGoalFragment" />
    </fragment>

    <fragment
        android:id="@+id/newGoalFragment"
        android:name="com.elijah.fitness.ui.goals.NewGoalFragment"
        android:label="@string/new_goal_title_create"
        tools:layout="@layout/fragment_new_goal">
        <argument
            android:name="goal_id"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />
    </fragment>

    <!--
      Profile is no longer in the bottom nav — it opens from the Home
      avatar. Kept as a nav destination so back-navigation works.
    -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.elijah.fitness.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <dialog
        android:id="@+id/chooseActivityBottomSheet"
        android:name="com.elijah.fitness.ui.log.ChooseActivityBottomSheet"
        android:label="@string/choose_activity_title"
        tools:layout="@layout/bottom_sheet_choose_activity">
        <action
            android:id="@+id/action_choose_to_log_distance"
            app:destination="@id/logDistanceWorkoutFragment"
            app:popUpTo="@id/workoutHistoryFragment" />
        <action
            android:id="@+id/action_choose_to_log_strength"
            app:destination="@id/logStrengthWorkoutFragment"
            app:popUpTo="@id/workoutHistoryFragment" />
        <action
            android:id="@+id/action_choose_to_live_tracking"
            app:destination="@id/liveTrackingFragment"
            app:popUpTo="@id/workoutHistoryFragment" />
    </dialog>

    <fragment
        android:id="@+id/liveTrackingFragment"
        android:name="com.elijah.fitness.ui.tracking.LiveTrackingFragment"
        android:label="@string/activity_type_running"
        tools:layout="@layout/fragment_live_tracking">
        <argument
            android:name="activityType"
            app:argType="string"
            android:defaultValue="RUNNING" />
    </fragment>

    <fragment
        android:id="@+id/logDistanceWorkoutFragment"
        android:name="com.elijah.fitness.ui.log.LogDistanceWorkoutFragment"
        android:label="@string/log_distance_title_running"
        tools:layout="@layout/fragment_log_distance_workout">
        <argument
            android:name="activityType"
            app:argType="string"
            android:defaultValue="RUNNING" />
        <!-- Phase 8c step 5: on save success, open the finished workout
             detail screen for the just-saved workout rather than popping
             back to the History list. -->
        <action
            android:id="@+id/action_log_distance_to_detail"
            app:destination="@id/workoutDetailFragment"
            app:popUpTo="@id/workoutHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/logStrengthWorkoutFragment"
        android:name="com.elijah.fitness.ui.log.LogStrengthWorkoutFragment"
        android:label="@string/log_strength_title"
        tools:layout="@layout/fragment_log_strength_workout">
        <argument
            android:name="activityType"
            app:argType="string"
            android:defaultValue="WEIGHTLIFTING" />
    </fragment>
</navigation>
