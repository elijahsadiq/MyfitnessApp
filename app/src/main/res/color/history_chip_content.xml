<?xml version="1.0" encoding="utf-8"?>
<!-- History filter chip text + icon: white on the dark selected chip, #111410 otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/text_on_dark" android:state_checked="true" />
    <item android:color="@color/text_on_lime" />
</selector>
