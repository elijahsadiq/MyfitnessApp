<?xml version="1.0" encoding="utf-8"?>
<!--
  Plus Jakarta Sans — bundled font family.

  Phase 8b replaces the previous Google-Fonts-provider downloadable XMLs
  with the actual TTF files, so every weight is available at inflate
  time and no `com.google.android.gms.fonts` fetch can leave us
  rendering in system Roboto. The TTFs live beside this file:

      plus_jakarta_sans_regular.ttf       weight 400
      plus_jakarta_sans_medium.ttf        weight 500
      plus_jakarta_sans_semibold.ttf      weight 600
      plus_jakarta_sans_bold.ttf          weight 700
      plus_jakarta_sans_extrabold.ttf     weight 800

  Material 3 widgets that pick a weight dynamically (toolbars, buttons,
  chips, Snackbars, dialog titles, tab labels) resolve to this family
  via the theme's `fontFamily` attribute. The project's own
  `TextAppearance.Fitness.*` styles reference specific weight TTFs
  directly, which works reliably below API 28 where font-family
  weight resolution is unreliable.

  Licensed under the SIL Open Font License 1.1
  (`docs/licenses/plus-jakarta-sans/OFL.txt`).
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/plus_jakarta_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/plus_jakarta_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/plus_jakarta_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/plus_jakarta_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/plus_jakarta_sans_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/plus_jakarta_sans_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/plus_jakarta_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/plus_jakarta_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

    <font
        android:font="@font/plus_jakarta_sans_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/plus_jakarta_sans_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
