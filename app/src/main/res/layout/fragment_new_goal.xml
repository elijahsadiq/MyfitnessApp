<?xml version="1.0" encoding="utf-8"?>
<!--
  "New goal" / "Edit goal" screen. Uses the shared toolbar (Up arrow +
  title) like every other sub-screen. The content scrolls inside a
  NestedScrollView; the lime submit button is pinned to the bottom and
  clears the gesture bar / keyboard via a window-insets listener.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm">

    <!-- ============== Content ============== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/newGoalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_lg"
        app:layout_constraintBottom_toTopOf="@id/newGoalSubmitContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_sm">

            <!-- ========== Choose an activity ========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_section_activity"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/newGoalActivityRun"
                    layout="@layout/view_goal_activity_tile" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/newGoalActivityRide"
                    layout="@layout/view_goal_activity_tile" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/newGoalActivityLift"
                    layout="@layout/view_goal_activity_tile" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/newGoalActivityAny"
                    layout="@layout/view_goal_activity_tile" />
            </LinearLayout>

            <!-- ========== What to track ========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/new_goal_section_metric"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/newGoalMetricHint"
                style="@style/TextAppearance.Fitness.BodyMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textColor="@color/text_secondary"
                tools:text="Track how far, how long or how often you run." />

            <LinearLayout
                android:id="@+id/newGoalMetricRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/newGoalMetric0"
                    layout="@layout/view_goal_metric_pill" />

                <Space
                    android:layout_width="@dimen/space_sm"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/newGoalMetric1"
                    layout="@layout/view_goal_metric_pill" />

                <Space
                    android:id="@+id/newGoalMetricSpacer2"
                    android:layout_width="@dimen/space_sm"
                    android:layout_height="match_parent" />

                <include
                    android:id="@+id/newGoalMetric2"
                    layout="@layout/view_goal_metric_pill" />
            </LinearLayout>

            <!-- ========== Set your target ========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/new_goal_section_target"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_goal_stepper_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <ImageView
                    android:id="@+id/newGoalTargetMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_goal_stepper_minus"
                    android:clickable="true"
                    android:contentDescription="@string/new_goal_decrease_target_content_description"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_minus_24"
                    app:tint="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/newGoalTargetValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:baselineAligned="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/newGoalTargetNumber"
                        style="@style/TextAppearance.Fitness.DisplayMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="44sp"
                        tools:text="50" />

                    <TextView
                        android:id="@+id/newGoalTargetUnit"
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="km" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/newGoalTargetPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_goal_stepper_plus"
                    android:clickable="true"
                    android:contentDescription="@string/new_goal_increase_target_content_description"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/text_on_dark" />
            </LinearLayout>

            <TextView
                android:id="@+id/newGoalTargetError"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAllCaps="false"
                android:textColor="@color/error_material"
                android:visibility="gone"
                tools:text="Distance target must be between 1 and 1000 km."
                tools:visibility="visible" />

            <!-- ========== How many days ========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/new_goal_section_days"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_goal_stepper_card"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/newGoalDaysMinus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_goal_stepper_minus"
                        android:clickable="true"
                        android:contentDescription="@string/new_goal_decrease_days_content_description"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/ic_minus_24"
                        app:tint="@color/text_primary" />

                    <LinearLayout
                        android:id="@+id/newGoalDaysValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:baselineAligned="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/newGoalDaysNumber"
                            style="@style/TextAppearance.Fitness.DisplayMetric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="44sp"
                            tools:text="30" />

                        <TextView
                            android:id="@+id/newGoalDaysUnit"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="days" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/newGoalDaysPlus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_goal_stepper_plus"
                        android:clickable="true"
                        android:contentDescription="@string/new_goal_increase_days_content_description"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/ic_add_24"
                        app:tint="@color/text_on_dark" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar_24"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/newGoalDateRange"
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        tools:text="Starts today · ends Mon 7 Oct" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/newGoalDaysError"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAllCaps="false"
                android:textColor="@color/error_material"
                android:visibility="gone"
                tools:text="Days must be between 1 and 365."
                tools:visibility="visible" />

            <!-- ========== Summary ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_goal_main_card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/TextAppearance.Fitness.LabelSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_goal_section_summary"
                    android:textColor="@color/goal_main_muted" />

                <TextView
                    android:id="@+id/newGoalSummaryTitle"
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:textColor="@color/text_on_dark"
                    android:textSize="21sp"
                    tools:text="Run 50 km in 30 days" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_goal_summary_tile"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/newGoalPaceLabel"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="false"
                            android:textColor="@color/goal_main_muted"
                            tools:text="Per day" />

                        <TextView
                            android:id="@+id/newGoalPaceValue"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAllCaps="false"
                            android:textColor="@color/lime_accent"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="1.7 km" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_goal_summary_tile"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_goal_deadline_label"
                            android:textAllCaps="false"
                            android:textColor="@color/goal_main_muted" />

                        <TextView
                            android:id="@+id/newGoalDeadlineValue"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAllCaps="false"
                            android:textColor="@color/lime_accent"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            tools:text="Mon 7 Oct" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============== Submit footer ============== -->
    <FrameLayout
        android:id="@+id/newGoalSubmitContainer"
        style="@style/Widget.Fitness.PinnedButtonBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newGoalSubmit"
            style="@style/Widget.Fitness.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:cornerRadius="999dp"
            app:icon="@drawable/ic_check_24"
            app:iconGravity="textStart"
            tools:text="Create goal" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/newGoalSubmitProgress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/text_on_lime"
            app:indicatorSize="24dp"
            tools:visibility="visible" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
