<?xml version="1.0" encoding="utf-8"?>
<!--
  Tracking-option pill. Height 58dp, border-radius 18dp, selected state
  driven by `setSelected(true)` on the root; text colour + background
  switch via selectors.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/goalMetricPillRoot"
    android:layout_width="0dp"
    android:layout_height="58dp"
    android:layout_weight="1"
    android:background="@drawable/bg_goal_metric_pill"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="8dp">

    <TextView
        android:id="@+id/goalMetricPillLabel"
        style="@style/TextAppearance.Fitness.LabelMd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAllCaps="false"
        android:textColor="@color/goal_metric_pill_label"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Distance" />

    <TextView
        android:id="@+id/goalMetricPillUnit"
        style="@style/TextAppearance.Fitness.LabelMd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.72"
        android:maxLines="1"
        android:textAllCaps="false"
        android:textColor="@color/goal_metric_pill_label"
        android:textSize="12sp"
        tools:text="km" />
</LinearLayout>
