<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_2xl"
    tools:context=".ui.history.WorkoutDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xl">

        <!-- Loading / error -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/detailLoadingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/text_primary"
            app:trackColor="@color/surface_container_high"
            tools:visibility="visible" />

        <!-- Header: activity type + date -->
        <TextView
            android:id="@+id/detailTitle"
            style="@style/TextAppearance.Fitness.HeadlineLg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Morning run" />

        <TextView
            android:id="@+id/detailSubtitle"
            style="@style/TextAppearance.Fitness.LabelMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            tools:text="Wed 2 Oct · 06:30" />

        <!-- Map (visible only when route points exist) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mapCard"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="@dimen/stroke_hairline"
            tools:visibility="visible">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats grid -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:contentPadding="@dimen/space_lg"
            app:strokeColor="@color/divider"
            app:strokeWidth="@dimen/stroke_hairline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Fitness.LabelSm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_distance_label"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/detailDistance"
                            style="@style/TextAppearance.Fitness.HeadlineLg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="5.20 km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Fitness.LabelSm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_duration_label"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/detailDuration"
                            style="@style/TextAppearance.Fitness.HeadlineLg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="28 min" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detailPaceLabel"
                            style="@style/TextAppearance.Fitness.LabelSm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_pace_label"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/detailPace"
                            style="@style/TextAppearance.Fitness.HeadlineLg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="5:23 /km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Fitness.LabelSm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_calories_label"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/detailCalories"
                            style="@style/TextAppearance.Fitness.HeadlineLg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="312 kcal" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Splits (only when a route exists) -->
        <TextView
            android:id="@+id/splitsHeader"
            style="@style/TextAppearance.Fitness.HeadlineSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/detail_splits_header"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/splitsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Notes -->
        <TextView
            android:id="@+id/notesHeader"
            style="@style/TextAppearance.Fitness.HeadlineSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/detail_notes_header"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/notesText"
            style="@style/TextAppearance.Fitness.BodyLg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:visibility="gone"
            tools:text="Felt strong after kilometre three."
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
