<?xml version="1.0" encoding="utf-8"?>
<!--
  One stat card on the detail screen's 2 x 2 grid. The highlighted
  variant (pace / speed) is driven from code — the fragment swaps the
  background and text colours. Number and unit share one auto-sizing
  TextView (see MetricText) so long values shrink instead of clipping.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailStatCardRoot"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_detail_stat_card_light"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <TextView
        android:id="@+id/detailStatCardLabel"
        style="@style/TextAppearance.Fitness.LabelMd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        tools:text="Distance" />

    <TextView
        android:id="@+id/detailStatCardValue"
        style="@style/TextAppearance.Fitness.DisplayMetric"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0sp"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        app:autoSizeMaxTextSize="26sp"
        app:autoSizeMinTextSize="14sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        tools:text="4.12 km" />
</LinearLayout>
