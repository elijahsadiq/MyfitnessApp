<?xml version="1.0" encoding="utf-8"?>
<!--
  Live tracking screen (phase 8c step 6). Rebuilt from Tracking.dc.html:
  edge-to-edge map, overlay row at the top with the GPS pill + minimise
  button, a re-centre button on the right edge, and a dark bottom panel
  with the elapsed time + three stats + three controls.

  The lock overlay sits at the top of the FrameLayout stack and is
  normally gone; the fragment flips it visible on Lock tap.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_background"
    tools:context=".ui.tracking.LiveTrackingFragment">

    <!-- Map behind everything. -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top overlay: GPS pill + minimise button -->
    <LinearLayout
        android:id="@+id/trackingTopOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp">

        <LinearLayout
            android:id="@+id/gpsQualityPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_tracking_overlay_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <View
                android:id="@+id/gpsQualityDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_tracking_gps_dot"
                android:backgroundTint="@color/lime_accent" />

            <TextView
                android:id="@+id/gpsQualityLabel"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:textColor="@color/text_on_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="GPS strong" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/minimiseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tracking_overlay_pill"
            android:clickable="true"
            android:contentDescription="@string/tracking_minimise_content_description"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_down_24"
            app:tint="@color/text_on_dark" />
    </LinearLayout>

    <!-- Re-centre button, right edge above the panel -->
    <ImageView
        android:id="@+id/recenterButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="360dp"
        android:background="@drawable/bg_tracking_overlay_pill"
        android:clickable="true"
        android:contentDescription="@string/tracking_recenter_content_description"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_crosshair_24"
        app:tint="@color/text_on_dark" />

    <!-- Bottom panel -->
    <LinearLayout
        android:id="@+id/trackingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_tracking_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingBottom="@dimen/space_xl">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_tracking_panel_handle" />

        <TextView
            android:id="@+id/trackingElapsedEyebrow"
            style="@style/TextAppearance.Fitness.LabelSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/goal_main_muted"
            tools:text="Running · elapsed" />

        <TextView
            android:id="@+id/elapsedText"
            style="@style/TextAppearance.Fitness.DisplayMetric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_on_dark"
            android:textSize="58sp"
            tools:text="00:24:36" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tracking_stat_distance"
                    android:textAllCaps="false"
                    android:textColor="@color/goal_main_muted" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/distanceText"
                        style="@style/TextAppearance.Fitness.DisplayMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_on_dark"
                        android:textSize="24sp"
                        tools:text="4.12" />

                    <TextView
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="4dp"
                        android:paddingBottom="2dp"
                        android:text="@string/tracking_unit_km"
                        android:textAllCaps="false"
                        android:textColor="@color/goal_main_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/paceLabel"
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:textColor="@color/goal_main_muted"
                    tools:text="Pace" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/paceText"
                        style="@style/TextAppearance.Fitness.DisplayMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/lime_accent"
                        android:textSize="24sp"
                        tools:text="5:52" />

                    <TextView
                        android:id="@+id/paceUnit"
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="4dp"
                        android:paddingBottom="2dp"
                        android:textAllCaps="false"
                        android:textColor="@color/goal_main_muted"
                        android:textSize="13sp"
                        tools:text="/km" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tracking_stat_calories"
                    android:textAllCaps="false"
                    android:textColor="@color/goal_main_muted" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/caloriesText"
                        style="@style/TextAppearance.Fitness.DisplayMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_on_dark"
                        android:textSize="24sp"
                        tools:text="288" />

                    <TextView
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="4dp"
                        android:paddingBottom="2dp"
                        android:text="@string/tracking_unit_kcal"
                        android:textAllCaps="false"
                        android:textColor="@color/goal_main_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/finishButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_tracking_panel_button"
                    android:clickable="true"
                    android:contentDescription="@string/tracking_finish_content_description"
                    android:focusable="true"
                    android:padding="20dp"
                    android:src="@drawable/ic_stop_square_24"
                    app:tint="@color/text_on_dark" />

                <TextView
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tracking_control_finish"
                    android:textAllCaps="false"
                    android:textColor="@color/goal_main_muted" />
            </LinearLayout>

            <Space
                android:layout_width="28dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/pauseResumeButton"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_tracking_pause_button"
                    android:clickable="true"
                    android:contentDescription="@string/tracking_control_pause"
                    android:focusable="true"
                    android:padding="27dp"
                    android:src="@drawable/ic_pause_24"
                    app:tint="@color/text_on_lime" />

                <TextView
                    android:id="@+id/pauseResumeLabel"
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tracking_control_pause"
                    android:textAllCaps="false"
                    android:textColor="@color/goal_main_muted" />
            </LinearLayout>

            <Space
                android:layout_width="28dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/lockButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_tracking_panel_button"
                    android:clickable="true"
                    android:contentDescription="@string/tracking_lock_content_description"
                    android:focusable="true"
                    android:padding="20dp"
                    android:src="@drawable/ic_lock_24"
                    app:tint="@color/text_on_dark" />

                <TextView
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tracking_control_lock"
                    android:textAllCaps="false"
                    android:textColor="@color/goal_main_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      Lock overlay. Fills the window and swallows every touch (and the
      system Back gesture via the fragment's OnBackPressedCallback).
      Hold the lock pill for ~1 second to dismiss.
    -->
    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0C0E0B"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/lockHoldArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_tracking_overlay_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_24"
                app:tint="@color/lime_accent" />

            <TextView
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/tracking_locked_hint"
                android:textAllCaps="false"
                android:textColor="@color/text_on_dark"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/lockHoldProgress"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="140dp"
            android:max="1000"
            android:progress="0"
            android:visibility="invisible"
            app:indicatorColor="@color/lime_accent"
            app:trackColor="@color/tracking_panel_border"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            tools:visibility="visible" />
    </FrameLayout>
</FrameLayout>
