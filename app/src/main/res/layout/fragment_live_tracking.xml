<?xml version="1.0" encoding="utf-8"?>
<!--
  Live tracking screen (phase 8c step 6, audit rework). Edge-to-edge map
  with a GPS pill + minimise button on top (viewing area) and every
  control in the dark bottom panel (interaction area, one-handed reach).

  The OSM credit and the re-centre button ride on top of the panel in
  the same bottom stack, so they stay just above it whatever height the
  panel ends up (font scale, nav-bar inset, small phones).

  The lock overlay sits at the top of the FrameLayout stack and is
  normally gone; the fragment flips it visible on Lock tap.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_background"
    tools:context=".ui.tracking.LiveTrackingFragment">

    <!-- Map behind everything. -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top overlay: GPS pill + minimise button -->
    <LinearLayout
        android:id="@+id/trackingTopOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg">

        <LinearLayout
            android:id="@+id/gpsQualityPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_tracking_overlay_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <View
                android:id="@+id/gpsQualityDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_tracking_gps_dot"
                android:backgroundTint="@color/lime_accent" />

            <TextView
                android:id="@+id/gpsQualityLabel"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:maxLines="1"
                android:textAllCaps="false"
                android:textColor="@color/text_on_dark"
                android:textStyle="bold"
                tools:text="GPS strong" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/minimiseButton"
            style="@style/Widget.Fitness.MapOverlayButton"
            android:contentDescription="@string/tracking_minimise_content_description"
            android:src="@drawable/ic_chevron_down_24" />
    </LinearLayout>

    <!-- Bottom stack: credit + re-centre row, then the dark panel. -->
    <LinearLayout
        android:id="@+id/trackingBottomStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingBottom="@dimen/space_md">

            <TextView
                android:id="@+id/mapAttribution"
                style="@style/Widget.Fitness.MapAttribution" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/recenterButton"
                style="@style/Widget.Fitness.MapOverlayButton"
                android:contentDescription="@string/tracking_recenter_content_description"
                android:src="@drawable/ic_crosshair_24" />
        </LinearLayout>

        <!-- Bottom panel -->
        <LinearLayout
            android:id="@+id/trackingPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tracking_panel"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_xl">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_tracking_panel_handle" />

            <TextView
                android:id="@+id/trackingElapsedEyebrow"
                style="@style/TextAppearance.Fitness.LabelSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:maxLines="1"
                android:textColor="@color/goal_main_muted"
                tools:text="Running" />

            <!-- Fixed height + uniform auto-size: the timer shrinks to fit
                 narrow phones and large font settings instead of clipping. -->
            <TextView
                android:id="@+id/elapsedText"
                style="@style/TextAppearance.Fitness.DisplayMetric"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0sp"
                android:maxLines="1"
                android:textColor="@color/text_on_dark"
                app:autoSizeMaxTextSize="58sp"
                app:autoSizeMinTextSize="32sp"
                app:autoSizeTextType="uniform"
                tools:text="00:24:36" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/tracking_stat_distance"
                        android:textColor="@color/goal_main_muted" />

                    <TextView
                        android:id="@+id/distanceText"
                        style="@style/Widget.Fitness.TrackingStatValue"
                        android:textColor="@color/text_on_dark"
                        tools:text="4.12 km" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/paceLabel"
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/goal_main_muted"
                        tools:text="Pace" />

                    <TextView
                        android:id="@+id/paceText"
                        style="@style/Widget.Fitness.TrackingStatValue"
                        android:textColor="@color/lime_accent"
                        tools:text="5:52 /km" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/tracking_stat_calories"
                        android:textColor="@color/goal_main_muted" />

                    <TextView
                        android:id="@+id/caloriesText"
                        style="@style/Widget.Fitness.TrackingStatValue"
                        android:textColor="@color/text_on_dark"
                        tools:text="288 kcal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Controls: secondary · primary · secondary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/finishButton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_tracking_panel_button"
                        android:clickable="true"
                        android:contentDescription="@string/tracking_finish_content_description"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="19dp"
                        android:src="@drawable/ic_stop_square_24"
                        app:tint="@color/text_on_dark" />

                    <TextView
                        android:id="@+id/finishLabel"
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="@string/tracking_control_finish"
                        android:textColor="@color/goal_main_muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="84dp"
                        android:layout_height="84dp">

                        <ImageView
                            android:id="@+id/pauseResumeButton"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_tracking_pause_button"
                            android:clickable="true"
                            android:contentDescription="@string/tracking_control_pause"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="27dp"
                            android:src="@drawable/ic_pause_24"
                            app:tint="@color/text_on_lime" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/saveProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/text_on_lime"
                            app:indicatorSize="32dp"
                            app:trackThickness="3dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/pauseResumeLabel"
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="@string/tracking_control_pause"
                        android:textColor="@color/goal_main_muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/lockButton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_tracking_panel_button"
                        android:clickable="true"
                        android:contentDescription="@string/tracking_lock_content_description"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="19dp"
                        android:src="@drawable/ic_lock_24"
                        app:tint="@color/text_on_dark" />

                    <TextView
                        android:id="@+id/lockLabel"
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="@string/tracking_control_lock"
                        android:textColor="@color/goal_main_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      Lock overlay. Fills the window and swallows every touch (and the
      system Back gesture via the fragment's OnBackPressedCallback).
      Hold the lock pill for ~1 second to dismiss; the bar under it
      fills while the finger is down.
    -->
    <LinearLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tracking_lock_scrim"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/lockHoldArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tracking_overlay_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_xl">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_24"
                app:tint="@color/lime_accent" />

            <TextView
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/tracking_locked_hint"
                android:textColor="@color/text_on_dark"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/lockHoldProgress"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:max="1000"
            android:progress="0"
            android:visibility="invisible"
            app:indicatorColor="@color/lime_accent"
            app:trackColor="@color/tracking_panel_border"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
