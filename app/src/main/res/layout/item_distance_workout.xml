<?xml version="1.0" encoding="utf-8"?>
<!--
  History / Home day-list row for a run, ride, swim or row (activities-v3
  History.dc.html): white card, 46dp icon tile, title + "date · time ·
  kcal", and the distance on the right (metres for swims, km otherwise).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Fitness.HistoryRow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/history_row_padding">

        <ImageView
            android:id="@+id/activityIcon"
            android:layout_width="@dimen/history_row_icon_tile"
            android:layout_height="@dimen/history_row_icon_tile"
            android:background="@drawable/bg_history_row_icon_tile"
            android:importantForAccessibility="no"
            android:padding="@dimen/history_row_icon_padding"
            tools:src="@drawable/ic_swim_24"
            tools:tint="@color/text_on_lime" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/history_row_text_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/workoutTitle"
                style="@style/Widget.Fitness.HistoryRowTitle"
                tools:text="Morning swim" />

            <TextView
                android:id="@+id/workoutSubtitle"
                style="@style/Widget.Fitness.HistoryRowSubtitle"
                tools:text="Today · 32 min · 270 kcal" />
        </LinearLayout>

        <TextView
            android:id="@+id/workoutValue"
            style="@style/Widget.Fitness.HistoryRowValue"
            tools:text="1,500 m" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
