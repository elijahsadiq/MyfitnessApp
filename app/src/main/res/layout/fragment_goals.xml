<?xml version="1.0" encoding="utf-8"?>
<!--
  Goals screen (phase 8b redesign). A single RecyclerView fills the
  screen; the title header, main-goal card and all section rows are view
  types inside the list, so the entire page scrolls as one.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    tools:context=".ui.goals.GoalsFragment">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/goalsLoadingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/lime_deep"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="@color/surface_container_high"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/goalsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fab_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/goalsLoadingBar"
        tools:listitem="@layout/item_goal_active" />

    <!-- Empty state. Rendered when the list has no items (see Step 8 for
         the Quick Start redesign). -->
    <LinearLayout
        android:id="@+id/goalsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/goalsLoadingBar"
        tools:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_tile"
            android:contentDescription="@string/goals_row_icon_content_description"
            android:padding="18dp"
            android:src="@drawable/ic_flag_24"
            app:tint="@color/lime_deep" />

        <TextView
            style="@style/TextAppearance.Fitness.HeadlineSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/goals_empty_title" />

        <TextView
            style="@style/TextAppearance.Fitness.BodyMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/goals_empty_body"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newGoalEmptyButton"
            style="@style/Widget.Fitness.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/goals_new_goal_button"
            app:icon="@drawable/ic_add_24"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
