<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    tools:context=".ui.goals.GoalsFragment">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/goalsLoadingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/lime_deep"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="@color/surface_container_high"
        tools:visibility="visible" />

    <!-- Header: title + New goal pill. Kept outside the list so it stays
         pinned while the list scrolls. -->
    <LinearLayout
        android:id="@+id/goalsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/goalsLoadingBar">

        <TextView
            android:id="@+id/goalsHeadline"
            style="@style/TextAppearance.Fitness.HeadlineLg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goals_headline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newGoalButton"
            style="@style/Widget.Fitness.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:paddingHorizontal="@dimen/space_lg"
            android:text="@string/goals_new_goal_button"
            app:icon="@drawable/ic_add_24"
            app:iconGravity="textStart" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/goalsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/fab_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/goalsHeader"
        tools:listitem="@layout/item_goal_active" />

    <!-- Empty state (shown when the list is empty and not loading). -->
    <LinearLayout
        android:id="@+id/goalsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/goalsHeader"
        tools:visibility="visible">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_tile"
            android:contentDescription="@string/goals_row_icon_content_description"
            android:padding="16dp"
            android:src="@drawable/ic_flag_24"
            app:tint="@color/lime_deep" />

        <TextView
            style="@style/TextAppearance.Fitness.HeadlineSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/goals_empty_title" />

        <TextView
            style="@style/TextAppearance.Fitness.BodyMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:text="@string/goals_empty_body"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
