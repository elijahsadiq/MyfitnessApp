<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    android:padding="@dimen/screen_margin"
    tools:context=".ui.progress.ProgressFragment">

    <ImageView
        android:id="@+id/progressIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_icon_tile"
        android:contentDescription="@null"
        android:padding="16dp"
        android:src="@drawable/ic_trending_up_24"
        app:layout_constraintBottom_toTopOf="@id/progressTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/lime_deep" />

    <TextView
        android:id="@+id/progressTitle"
        style="@style/TextAppearance.Fitness.HeadlineSm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/progress_placeholder_title"
        app:layout_constraintBottom_toTopOf="@id/progressBody"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressIcon" />

    <TextView
        android:id="@+id/progressBody"
        style="@style/TextAppearance.Fitness.BodyMd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:text="@string/progress_placeholder_body"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressTitle" />
</androidx.constraintlayout.widget.ConstraintLayout>
