<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    tools:context=".ui.progress.ProgressFragment">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressLoadingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/text_primary"
        app:trackColor="@color/surface_container_high"
        tools:visibility="visible" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/progressScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_height_plus_breathing_room">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_xl">

            <TextView
                style="@style/TextAppearance.Fitness.HeadlineLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/progress_title" />

            <!-- Period selector -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/periodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/periodWeek"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/progress_period_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/periodMonth"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/progress_period_month" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/periodYear"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/progress_period_year" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Activity filter chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterAll"
                    style="@style/Widget.Fitness.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/progress_filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterRunning"
                    style="@style/Widget.Fitness.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/activity_type_running" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterCycling"
                    style="@style/Widget.Fitness.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/activity_type_cycling" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterWeightlifting"
                    style="@style/Widget.Fitness.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/activity_type_weightlifting" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/progressEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_xl"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_empty_title" />

                <TextView
                    style="@style/TextAppearance.Fitness.BodyMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/progress_empty_body"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Content block (hidden when empty) -->
            <LinearLayout
                android:id="@+id/progressContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Period activity chart -->
                <TextView
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:text="@string/progress_section_period_chart" />

                <com.elijah.fitness.ui.progress.BarChartView
                    android:id="@+id/periodChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm" />

                <!-- Per-activity statistics container -->
                <LinearLayout
                    android:id="@+id/perActivityContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:orientation="vertical" />

                <!-- Personal records -->
                <TextView
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:text="@string/progress_section_personal_records" />

                <LinearLayout
                    android:id="@+id/personalRecordsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
