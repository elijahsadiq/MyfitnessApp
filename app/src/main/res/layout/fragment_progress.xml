<?xml version="1.0" encoding="utf-8"?>
<!--
  Progress tab. Same header as every tab, then the two filters (period,
  activity), the active-minutes chart, per-activity stats cards and the
  lifetime personal records card.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    tools:context=".ui.progress.ProgressFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/progressScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Screen header (same position and height on every tab) -->
            <LinearLayout style="@style/Widget.Fitness.ScreenHeader">

                <TextView
                    style="@style/Widget.Fitness.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/progress_title" />
            </LinearLayout>

            <!-- Period selector -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/periodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_lg"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/periodWeek"
                    style="@style/Widget.Fitness.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/progress_period_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/periodMonth"
                    style="@style/Widget.Fitness.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/progress_period_month" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/periodYear"
                    style="@style/Widget.Fitness.Button.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/progress_period_year" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Activity filter chips: scroll sideways on narrow phones -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_margin"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/filterChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/space_sm"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterAll"
                        style="@style/Widget.Fitness.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/progress_filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterRunning"
                        style="@style/Widget.Fitness.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_type_running" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterCycling"
                        style="@style/Widget.Fitness.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_type_cycling" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filterWeightlifting"
                        style="@style/Widget.Fitness.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_type_weightlifting" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/progressEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_xl"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_icon_tile"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_trending_up_24"
                    app:tint="@color/text_primary" />

                <TextView
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:text="@string/progress_empty_title" />

                <TextView
                    android:id="@+id/progressEmptyBody"
                    style="@style/TextAppearance.Fitness.BodyMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/progress_empty_body"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Content block (hidden when empty) -->
            <LinearLayout
                android:id="@+id/progressContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin">

                <!-- Period activity chart -->
                <TextView
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:accessibilityHeading="true"
                    android:text="@string/progress_section_period_chart" />

                <com.elijah.fitness.ui.progress.BarChartView
                    android:id="@+id/periodChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm" />

                <!-- Per-activity statistics container -->
                <LinearLayout
                    android:id="@+id/perActivityContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:orientation="vertical" />

                <!-- Personal records (lifetime) -->
                <TextView
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:accessibilityHeading="true"
                    android:text="@string/progress_section_personal_records" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Fitness.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm">

                    <LinearLayout
                        android:id="@+id/personalRecordsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Overlaid (not stacked) so showing it never shifts the content. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressLoadingBar"
        style="@style/Widget.Fitness.TopLoadingBar"
        tools:visibility="visible" />
</FrameLayout>
