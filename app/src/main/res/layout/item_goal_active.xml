<?xml version="1.0" encoding="utf-8"?>
<!--
  One active (incomplete) goal row (Goals v2 redesign).

  Top row: icon tile · [title + "N / M unit"] · "N days left" clock pill.
  Below: an 8dp lime progress bar.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="@dimen/radius_row"
    app:cardElevation="0dp"
    app:contentPadding="@dimen/card_padding"
    app:strokeColor="@color/divider"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/icon_tile_size"
                android:layout_height="@dimen/icon_tile_size"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:id="@+id/activeIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:tint="@color/text_primary"
                    tools:src="@drawable/ic_run_24" />
            </FrameLayout>

            <!-- Title gets the full width and may wrap — never cut off. -->
            <TextView
                android:id="@+id/activeTitle"
                style="@style/TextAppearance.Fitness.BodyLg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                tools:text="Ride 100 km in 30 days" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/activeValue"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                tools:text="58 / 100 km" />

            <LinearLayout
                android:id="@+id/activeDaysPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_section_summary_pill"
                android:gravity="center_vertical"
                android:minHeight="26dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_history_24"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/activeTimeRemaining"
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    tools:text="12 days left" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/activeProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:indicatorColor="@color/lime_accent"
            app:indicatorTrackGapSize="0dp"
            app:trackColor="@color/surface_container_high"
            app:trackCornerRadius="4dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp"
            tools:progress="58" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
