<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_sm">

    <TextView
        android:id="@+id/splitKm"
        style="@style/TextAppearance.Fitness.LabelMd"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        tools:text="1" />

    <View
        android:id="@+id/splitBar"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginHorizontal="@dimen/space_sm"
        android:layout_weight="1"
        android:background="@color/lime_accent" />

    <TextView
        android:id="@+id/splitPace"
        style="@style/TextAppearance.Fitness.LabelMd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        tools:text="5:23 /km" />
</LinearLayout>
