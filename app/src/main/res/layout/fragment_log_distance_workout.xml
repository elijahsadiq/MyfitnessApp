<?xml version="1.0" encoding="utf-8"?>
<!--
  Manual log form (phase 8c step 5). Rebuilt from LogRun.dc.html; the
  same layout serves running, cycling and rowing (phase 8d). The header
  (round back button + "Log a run" / "Log a ride" / "Log a row") is the
  Log a swim header; the shared toolbar is hidden on this screen. The duration
  cells are the shared DurationInputView (LogSwim.dc.html). The dark
  summary card updates as the user types; the Save button is pinned to
  the bottom via a ConstraintLayout + the inset-aware helper on the
  fragment.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    tools:context=".ui.log.LogDistanceWorkoutFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_lg"
        app:layout_constraintBottom_toTopOf="@id/logSaveContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/log_header_padding_top">

            <!-- =========== Header (same as Log a swim) =========== -->
            <LinearLayout
                android:id="@+id/logHeader"
                style="@style/Widget.Fitness.LogHeaderRow">

                <ImageButton
                    android:id="@+id/logBack"
                    style="@style/Widget.Fitness.HeaderBackButton"
                    android:contentDescription="@string/action_back_content_description" />

                <!-- "Log a run" / "Log a ride" / "Log a row", set by the fragment. -->
                <TextView
                    android:id="@+id/logTitle"
                    style="@style/Widget.Fitness.LogHeaderTitle"
                    android:text="@string/log_run_title" />
            </LinearLayout>

            <!-- =========== Live summary (dark) =========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/log_header_gap_below"
                android:background="@drawable/bg_goal_main_card_bg"
                android:orientation="vertical"
                android:padding="@dimen/log_summary_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/logSummaryActivityPill"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/log_summary_pill_height"
                        android:background="@drawable/bg_log_summary_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/log_summary_pill_padding">

                        <ImageView
                            android:id="@+id/logSummaryActivityIcon"
                            android:layout_width="@dimen/log_summary_pill_icon"
                            android:layout_height="@dimen/log_summary_pill_icon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_run_24"
                            app:tint="@color/lime_accent" />

                        <TextView
                            android:id="@+id/logSummaryActivityLabel"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/log_summary_pill_gap"
                            android:textAllCaps="false"
                            android:textColor="@color/lime_accent"
                            android:textStyle="bold"
                            tools:text="Running" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/log_summary_stats_gap"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/logSummaryPrimaryLabel"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/goal_main_muted"
                            tools:text="Avg pace" />

                        <TextView
                            android:id="@+id/logSummaryPrimaryValue"
                            style="@style/Widget.Fitness.SummaryStatValue"
                            android:textColor="@color/lime_accent"
                            tools:text="5:30 /km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/logSummarySecondaryLabel"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/goal_main_muted"
                            tools:text="Avg speed" />

                        <TextView
                            android:id="@+id/logSummarySecondaryValue"
                            style="@style/Widget.Fitness.SummaryStatValue"
                            tools:text="10.0 km/h" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/log_summary_metric_calories"
                            android:textColor="@color/goal_main_muted" />

                        <TextView
                            android:id="@+id/logSummaryCaloriesValue"
                            style="@style/Widget.Fitness.SummaryStatValue"
                            tools:text="340 kcal" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/logSummaryIncomplete"
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/log_summary_note_gap"
                    android:text="@string/log_summary_incomplete"
                    android:textAllCaps="false"
                    android:textColor="@color/goal_main_muted" />
            </LinearLayout>

            <!-- =========== When =========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/log_form_section_gap"
                android:text="@string/log_when_header"
                android:textSize="@dimen/text_size_log_form_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_label_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/logDateCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/log_when_card_min_height"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_log_when_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/log_when_card_padding">

                    <FrameLayout
                        android:layout_width="@dimen/log_when_icon_tile"
                        android:layout_height="@dimen/log_when_icon_tile"
                        android:background="@drawable/bg_log_when_icon">

                        <ImageView
                            android:layout_width="@dimen/log_when_icon"
                            android:layout_height="@dimen/log_when_icon"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar_24"
                            app:tint="@color/text_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/log_when_label_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/logDateEyebrow"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary"
                            tools:text="Today" />

                        <TextView
                            android:id="@+id/logDateValue"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_log_when_value"
                            android:textStyle="bold"
                            tools:text="Wed 7 Oct" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/log_when_cards_gap"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/logTimeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:minHeight="@dimen/log_when_card_min_height"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_log_when_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/log_when_card_padding">

                    <FrameLayout
                        android:layout_width="@dimen/log_when_icon_tile"
                        android:layout_height="@dimen/log_when_icon_tile"
                        android:background="@drawable/bg_log_when_icon">

                        <ImageView
                            android:layout_width="@dimen/log_when_icon"
                            android:layout_height="@dimen/log_when_icon"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_history_24"
                            app:tint="@color/text_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/log_when_label_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/log_time_eyebrow"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/logTimeValue"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_log_when_value"
                            android:textStyle="bold"
                            tools:text="22:45" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/logDateError"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/log_form_error_gap"
                android:textAllCaps="false"
                android:textColor="@color/error_material"
                android:visibility="gone"
                tools:text="Date can't be in the future."
                tools:visibility="visible" />

            <!-- =========== How long? =========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/log_form_section_gap"
                android:text="@string/log_how_long_header"
                android:textSize="@dimen/text_size_log_form_section" />

            <!-- Shared h / min / s cells (phase 8d, same as Log a swim). -->
            <com.elijah.fitness.ui.components.DurationInputView
                android:id="@+id/durationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_label_gap" />

            <TextView
                android:id="@+id/logDurationError"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/log_form_error_gap"
                android:textAllCaps="false"
                android:textColor="@color/error_material"
                android:visibility="gone"
                tools:text="Minutes and seconds must be between 0 and 59."
                tools:visibility="visible" />

            <!-- =========== How far? =========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/log_form_section_gap"
                android:text="@string/log_how_far_header"
                android:textSize="@dimen/text_size_log_form_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_label_gap"
                android:background="@drawable/bg_log_form_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/log_distance_card_padding_horizontal"
                android:paddingVertical="@dimen/log_distance_card_padding_vertical">

                <EditText
                    android:id="@+id/distanceInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:hint="@string/log_distance_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:minHeight="@dimen/log_distance_input_min_height"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/outline_variant"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textSize="@dimen/text_size_log_distance_input" />

                <TextView
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/log_distance_unit_gap"
                    android:text="@string/log_distance_unit"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_log_distance_unit"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/logDistanceError"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/log_form_error_gap"
                android:textAllCaps="false"
                android:textColor="@color/error_material"
                android:visibility="gone"
                tools:text="Distance can't exceed 300 km."
                tools:visibility="visible" />

            <!-- =========== Notes =========== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/log_form_section_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_notes_label"
                    android:textSize="@dimen/text_size_log_form_section" />

                <TextView
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/log_notes_optional_gap"
                    android:text="@string/log_notes_optional_suffix"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <EditText
                android:id="@+id/notesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_label_gap"
                android:background="@drawable/bg_log_form_card"
                android:gravity="top|start"
                android:hint="@string/log_notes_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="@dimen/card_padding"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_size_notes" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/logSaveContainer"
        style="@style/Widget.Fitness.PinnedButtonBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.Fitness.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_cta_height"
            app:icon="@drawable/ic_check_24"
            app:iconGravity="textStart"
            tools:text="Save run" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
