<?xml version="1.0" encoding="utf-8"?>
<!--
  Manual log form (phase 8c step 5). Rebuilt from LogRun.dc.html; the
  same layout serves running + cycling. The dark summary card updates
  as the user types; the Save button is pinned to the bottom via a
  ConstraintLayout + the inset-aware helper on the fragment.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_warm"
    tools:context=".ui.log.LogDistanceWorkoutFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_lg"
        app:layout_constraintBottom_toTopOf="@id/logSaveContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_md">

            <!-- =========== Live summary (dark) =========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_goal_main_card_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/logSummaryActivityPill"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_log_summary_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:id="@+id/logSummaryActivityIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_run_24"
                            app:tint="@color/lime_accent" />

                        <TextView
                            android:id="@+id/logSummaryActivityLabel"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textAllCaps="false"
                            android:textColor="@color/lime_accent"
                            android:textStyle="bold"
                            tools:text="Running" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/logSummaryPrimaryLabel"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/goal_main_muted"
                            tools:text="Avg pace" />

                        <TextView
                            android:id="@+id/logSummaryPrimaryValue"
                            style="@style/Widget.Fitness.SummaryStatValue"
                            android:textColor="@color/lime_accent"
                            tools:text="5:30 /km" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/logSummarySecondaryLabel"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/goal_main_muted"
                            tools:text="Avg speed" />

                        <TextView
                            android:id="@+id/logSummarySecondaryValue"
                            style="@style/Widget.Fitness.SummaryStatValue"
                            tools:text="10.0 km/h" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/log_summary_metric_calories"
                            android:textColor="@color/goal_main_muted" />

                        <TextView
                            android:id="@+id/logSummaryCaloriesValue"
                            style="@style/Widget.Fitness.SummaryStatValue"
                            tools:text="340 kcal" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/logSummaryIncomplete"
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/log_summary_incomplete"
                    android:textAllCaps="false"
                    android:textColor="@color/goal_main_muted" />
            </LinearLayout>

            <!-- =========== When =========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/log_when_header"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/logDateCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:minHeight="64dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_log_when_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_log_when_icon">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar_24"
                            app:tint="@color/text_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/logDateEyebrow"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary"
                            tools:text="Today" />

                        <TextView
                            android:id="@+id/logDateValue"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Wed 7 Oct" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/logTimeCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:minHeight="64dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingVertical="@dimen/space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_log_when_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_log_when_icon">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_history_24"
                            app:tint="@color/text_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/log_time_eyebrow"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/logTimeValue"
                            style="@style/TextAppearance.Fitness.LabelMd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="22:45" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/logDateError"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAllCaps="false"
                android:textColor="@color/error_material"
                android:visibility="gone"
                tools:text="Date can't be in the future."
                tools:visibility="visible" />

            <!-- =========== How long? =========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/log_how_long_header"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_log_form_card"
                android:baselineAligned="false"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/hoursInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_log_duration_cell"
                        android:gravity="center"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="2"
                        android:minHeight="64dp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:hint="@string/log_duration_hint"
                        android:textColorHint="@color/outline_variant"
                        android:textSize="34sp"
                        tools:text="0" />

                    <TextView
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/log_duration_hours_label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Fitness.DisplayMetric"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text=":"
                    android:textColor="@color/goal_main_muted"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/minutesInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_log_duration_cell"
                        android:gravity="center"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="2"
                        android:minHeight="64dp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:hint="@string/log_duration_hint"
                        android:textColorHint="@color/outline_variant"
                        android:textSize="34sp"
                        tools:text="30" />

                    <TextView
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/log_duration_minutes_label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Fitness.DisplayMetric"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text=":"
                    android:textColor="@color/goal_main_muted"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/secondsInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_log_duration_cell"
                        android:gravity="center"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="2"
                        android:minHeight="64dp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:hint="@string/log_duration_hint"
                        android:textColorHint="@color/outline_variant"
                        android:textSize="34sp"
                        tools:text="0" />

                    <TextView
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/log_duration_seconds_label"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/logDurationError"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAllCaps="false"
                android:textColor="@color/error_material"
                android:visibility="gone"
                tools:text="Minutes and seconds must be between 0 and 59."
                tools:visibility="visible" />

            <!-- =========== How far? =========== -->
            <TextView
                style="@style/TextAppearance.Fitness.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/log_how_far_header"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_log_form_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <EditText
                    android:id="@+id/distanceInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:hint="@string/log_distance_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:minHeight="64dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/outline_variant"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        app:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:textSize="44sp" />

                <TextView
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/log_distance_unit"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/logDistanceError"
                style="@style/TextAppearance.Fitness.LabelMd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAllCaps="false"
                android:textColor="@color/error_material"
                android:visibility="gone"
                tools:text="Distance can't exceed 300 km."
                tools:visibility="visible" />

            <!-- =========== Notes =========== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_notes_label"
                    android:textSize="16sp" />

                <TextView
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/log_notes_optional_suffix"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <EditText
                android:id="@+id/notesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_log_form_card"
                android:gravity="top|start"
                android:hint="@string/log_notes_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/logSaveContainer"
        style="@style/Widget.Fitness.PinnedButtonBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.Fitness.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:icon="@drawable/ic_check_24"
            app:iconGravity="textStart"
            tools:text="Save run" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
