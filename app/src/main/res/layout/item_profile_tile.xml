<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:contentPadding="@dimen/space_md"
    app:strokeColor="@color/divider"
    app:strokeWidth="@dimen/stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tileValue"
            style="@style/TextAppearance.Fitness.HeadlineSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="12" />

        <TextView
            android:id="@+id/tileLabel"
            style="@style/TextAppearance.Fitness.LabelSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            tools:text="Workouts" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
