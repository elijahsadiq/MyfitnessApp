<?xml version="1.0" encoding="utf-8"?>
<!-- Compact goal row for the Home Goals card. No card wrapper — the
     parent card already has the styling. Two of these are `<include>`d
     into the Home layout with distinct IDs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeGoalRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/homeGoalTitle"
            style="@style/TextAppearance.Fitness.BodyMd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            tools:text="Run 20 km this week" />

        <TextView
            android:id="@+id/homeGoalValue"
            style="@style/TextAppearance.Fitness.BodyMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:textColor="@color/text_primary"
            tools:text="12 / 20 km" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/homeGoalBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        app:indicatorColor="@color/lime_accent"
        app:trackColor="@color/surface_container_high"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp"
        tools:progress="60" />
</LinearLayout>
