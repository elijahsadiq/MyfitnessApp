<?xml version="1.0" encoding="utf-8"?>
<!--
  Goals tab header — first row of the goals list. Same style (top gap,
  height, margins) as the header on every other tab, so the title never
  jumps when switching tabs. "New goal" lives in the FAB at the bottom,
  within thumb reach.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Fitness.ScreenHeader">

    <TextView
        android:id="@+id/goalsHeaderTitle"
        style="@style/Widget.Fitness.ScreenTitle"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:text="@string/goals_headline" />
</LinearLayout>
