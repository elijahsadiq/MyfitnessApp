<?xml version="1.0" encoding="utf-8"?>
<!--
  Featured goal card: dark hero with a large progress ring and a
  headline. Rendered for the single most-urgent incomplete goal.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/featuredCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin"
    android:layout_marginTop="@dimen/space_lg"
    android:background="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:contentPadding="@dimen/card_padding_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/featuredEyebrow"
            style="@style/TextAppearance.Fitness.LabelSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_dark_muted"
            tools:text="Monthly target" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/featuredTitle"
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_dark"
                    tools:text="Run 50 km this month" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:baselineAligned="true"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/featuredValue"
                        style="@style/TextAppearance.Fitness.DisplayMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_on_dark"
                        tools:text="32" />

                    <TextView
                        android:id="@+id/featuredValueSuffix"
                        style="@style/TextAppearance.Fitness.BodyMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="6dp"
                        android:textColor="@color/text_on_dark_muted"
                        tools:text="/ 50 km" />
                </LinearLayout>

                <TextView
                    android:id="@+id/featuredTimeRemaining"
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/text_on_dark_muted"
                    tools:text="12 days left" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/space_md">

                <com.elijah.fitness.ui.dashboard.ProgressRingView
                    android:id="@+id/featuredProgressRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/goals_featured_icon_content_description" />

                <TextView
                    android:id="@+id/featuredProgressRingLabel"
                    style="@style/TextAppearance.Fitness.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/text_on_dark"
                    tools:text="64%" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
