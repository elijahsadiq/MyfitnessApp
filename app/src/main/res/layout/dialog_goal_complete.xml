<?xml version="1.0" encoding="utf-8"?>
<!--
  Goal-complete pop-up (GoalComplete.dc.html, phase 8d step 7). The
  window background is the 62 % scrim; the confetti sits above it and
  behind the card. The card is centred vertically, with the 92dp trophy
  circle centred on its top edge. Scrolls only on very short screens.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/goalCompleteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.elijah.fitness.ui.celebration.ConfettiView
        android:id="@+id/goalCompleteConfetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/goalCompleteScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="@dimen/goal_complete_scroll_padding"
        android:paddingBottom="@dimen/goal_complete_scroll_padding"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/goalCompleteCardFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/goal_complete_side_margin"
                android:layout_marginEnd="@dimen/goal_complete_side_margin">

                <LinearLayout
                    android:id="@+id/goalCompleteCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/goal_complete_trophy_overlap"
                    android:background="@drawable/bg_goal_complete_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/goal_complete_card_padding"
                    android:paddingTop="@dimen/goal_complete_card_padding_top"
                    android:paddingEnd="@dimen/goal_complete_card_padding"
                    android:paddingBottom="@dimen/goal_complete_card_padding">

                    <TextView
                        android:id="@+id/goalCompletePill"
                        style="@style/TextAppearance.Fitness.GoalCompletePill"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/goal_complete_pill_height"
                        android:background="@drawable/bg_goal_complete_pill"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="@dimen/goal_complete_pill_padding"
                        android:paddingEnd="@dimen/goal_complete_pill_padding"
                        android:text="@string/goal_complete_pill" />

                    <TextView
                        android:id="@+id/goalCompleteTitle"
                        style="@style/TextAppearance.Fitness.GoalCompleteTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/goal_complete_gap"
                        android:accessibilityHeading="true"
                        android:gravity="center"
                        android:text="@string/goal_complete_title"
                        tools:targetApi="28" />

                    <TextView
                        android:id="@+id/goalCompleteBody"
                        style="@style/TextAppearance.Fitness.GoalCompleteBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/goal_complete_gap"
                        android:gravity="center"
                        tools:text="Ride 100 km in 30 days, finished 4 days early." />

                    <LinearLayout
                        android:id="@+id/goalCompleteTiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/goal_complete_gap"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/goal_complete_tiles_padding_top">

                        <LinearLayout
                            android:id="@+id/goalCompleteTileAchieved"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_goal_complete_tile_light"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/goal_complete_tile_padding_h"
                            android:paddingTop="@dimen/goal_complete_tile_padding_v"
                            android:paddingEnd="@dimen/goal_complete_tile_padding_h"
                            android:paddingBottom="@dimen/goal_complete_tile_padding_v">

                            <TextView
                                android:id="@+id/goalCompleteAchievedValue"
                                style="@style/Widget.Fitness.GoalCompleteTileValue"
                                tools:text="100" />

                            <TextView
                                android:id="@+id/goalCompleteAchievedLabel"
                                style="@style/Widget.Fitness.GoalCompleteTileLabel"
                                android:layout_marginTop="@dimen/goal_complete_tile_text_gap"
                                tools:text="km ridden" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/goalCompleteTileDays"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/goal_complete_tile_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_goal_complete_tile_light"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/goal_complete_tile_padding_h"
                            android:paddingTop="@dimen/goal_complete_tile_padding_v"
                            android:paddingEnd="@dimen/goal_complete_tile_padding_h"
                            android:paddingBottom="@dimen/goal_complete_tile_padding_v">

                            <TextView
                                android:id="@+id/goalCompleteDaysValue"
                                style="@style/Widget.Fitness.GoalCompleteTileValue"
                                tools:text="26" />

                            <TextView
                                android:id="@+id/goalCompleteDaysLabel"
                                style="@style/Widget.Fitness.GoalCompleteTileLabel"
                                android:layout_marginTop="@dimen/goal_complete_tile_text_gap"
                                tools:text="days taken" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/goalCompleteTileKcal"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/goal_complete_tile_gap"
                            android:layout_weight="1"
                            android:background="@drawable/bg_goal_complete_tile_dark"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/goal_complete_tile_padding_h"
                            android:paddingTop="@dimen/goal_complete_tile_padding_v"
                            android:paddingEnd="@dimen/goal_complete_tile_padding_h"
                            android:paddingBottom="@dimen/goal_complete_tile_padding_v">

                            <TextView
                                android:id="@+id/goalCompleteKcalValue"
                                style="@style/Widget.Fitness.GoalCompleteTileValue.OnDark"
                                tools:text="2,700" />

                            <TextView
                                android:id="@+id/goalCompleteKcalLabel"
                                style="@style/Widget.Fitness.GoalCompleteTileLabel.OnDark"
                                android:layout_marginTop="@dimen/goal_complete_tile_text_gap"
                                android:text="@string/goal_complete_kcal_burned" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/goalCompleteNewGoal"
                        style="@style/Widget.Fitness.Button.Primary.Large.GoalComplete"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/goal_complete_cta_margin_top"
                        android:text="@string/goal_complete_set_new_goal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/goal_complete_gap"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/goalCompleteShare"
                            style="@style/Widget.Fitness.Button.GoalCompleteShare"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/goal_complete_share" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/goalCompleteDone"
                            style="@style/Widget.Fitness.Button.GoalCompleteDone"
                            android:layout_width="0dp"
                            android:layout_marginStart="@dimen/goal_complete_action_gap"
                            android:layout_weight="1"
                            android:text="@string/goal_complete_done" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/goalCompleteTrophy"
                    android:layout_width="@dimen/goal_complete_trophy_size"
                    android:layout_height="@dimen/goal_complete_trophy_size"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_goal_complete_trophy"
                    android:contentDescription="@string/goal_complete_trophy_cd"
                    android:padding="@dimen/goal_complete_trophy_icon_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_trophy_24"
                    app:tint="@color/text_on_lime" />
            </FrameLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
