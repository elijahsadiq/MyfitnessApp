<?xml version="1.0" encoding="utf-8"?>
<!--
  Activity selector tile. Selected state is driven from code by
  `setSelected(true)` on the root — the drawable + text colour selectors
  resolve the dark/lime treatment automatically.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/goalActivityTileRoot"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:minHeight="84dp"
    android:background="@drawable/bg_goal_activity_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="start"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_goal_activity_icon">

        <ImageView
            android:id="@+id/goalActivityTileIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/text_primary"
            tools:src="@drawable/ic_run_24" />
    </FrameLayout>

    <!-- Grows with large fonts instead of clipping the label. -->
    <TextView
        android:id="@+id/goalActivityTileLabel"
        style="@style/TextAppearance.Fitness.LabelMd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textAllCaps="false"
        android:textColor="@color/goal_activity_tile_label"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Running" />
</LinearLayout>
