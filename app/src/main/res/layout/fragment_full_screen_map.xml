<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen interactive map of a saved route. Opens from the workout-
  detail map card. Dark map tiles, glowing lime route, the OSM credit in
  the bottom-start corner and a close button top-end that pops back.
  The overlay container takes the system-bar insets so both controls
  clear the status bar and the gesture / navigation bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_background"
    tools:context=".ui.history.FullScreenMapFragment">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/fullMapOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/space_lg">

        <ImageView
            android:id="@+id/fullMapCloseButton"
            style="@style/Widget.Fitness.MapOverlayButton"
            android:layout_gravity="top|end"
            android:contentDescription="@string/full_map_close_content_description"
            android:src="@drawable/ic_close_24" />

        <TextView
            android:id="@+id/mapAttribution"
            style="@style/Widget.Fitness.MapAttribution"
            android:layout_gravity="bottom|start" />
    </FrameLayout>
</FrameLayout>
