<?xml version="1.0" encoding="utf-8"?>
<!--
  Delete-account confirmation dialog. Same look as dialog_delete_goal
  (trash icon on a pale-red circle, Cancel + destructive pills), plus a
  field the user must type DELETE into before the Delete pill enables.
  The hint is set in code (it names the confirm word).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_goal_delete_badge">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/goals_delete_badge_content_description"
            android:src="@drawable/ic_delete_24"
            app:tint="@color/destructive" />
    </FrameLayout>

    <TextView
        style="@style/TextAppearance.Fitness.HeadlineSm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/profile_delete_account_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        style="@style/TextAppearance.Fitness.BodyMd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/profile_delete_account_body"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/confirmLayout"
        style="@style/Widget.Fitness.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/confirmInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/deleteAccountCancel"
            style="@style/TextAppearance.Fitness.LabelMd"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_goal_cancel_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/profile_edit_cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="10dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/deleteAccountConfirm"
            style="@style/TextAppearance.Fitness.LabelMd"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_goal_delete_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/profile_delete_account_confirm"
            android:textAllCaps="false"
            android:textColor="@color/text_on_dark"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
