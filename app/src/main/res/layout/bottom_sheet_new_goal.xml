<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_lg">

        <TextView
            android:id="@+id/newGoalTitle"
            style="@style/TextAppearance.Fitness.HeadlineSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_goal_title_create"
            tools:text="New goal" />

        <!-- ============= Activity ============= -->
        <TextView
            style="@style/TextAppearance.Fitness.LabelSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/new_goal_section_activity"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/activityChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:chipSpacingHorizontal="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleLine="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActivityRunning"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_activity_running" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActivityCycling"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_activity_cycling" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActivityWeightlifting"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_activity_weightlifting" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActivityAny"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_activity_any" />
        </com.google.android.material.chip.ChipGroup>

        <!-- ============= Goal type ============= -->
        <TextView
            style="@style/TextAppearance.Fitness.LabelSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/new_goal_section_type"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/goalTypeChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:chipSpacingHorizontal="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleLine="false"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTypeDistance"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_type_distance" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTypeCount"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_type_count" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTypeDuration"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_type_duration" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTypeVolume"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_type_volume" />
        </com.google.android.material.chip.ChipGroup>

        <!-- ============= Period ============= -->
        <TextView
            style="@style/TextAppearance.Fitness.LabelSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/new_goal_section_period"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/periodChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:chipSpacingHorizontal="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPeriodWeek"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/new_goal_period_week" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPeriodMonth"
                style="@style/Widget.Fitness.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_period_month" />
        </com.google.android.material.chip.ChipGroup>

        <!-- ============= Target ============= -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/targetFieldLayout"
            style="@style/Widget.Fitness.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:hint="@string/new_goal_target_hint"
            app:suffixText="@string/goal_unit_km">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/targetInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:minHeight="@dimen/button_pill_height" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============= Title ============= -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/titleFieldLayout"
            style="@style/Widget.Fitness.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/new_goal_title_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:minHeight="@dimen/button_pill_height" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ============= Preview ============= -->
        <TextView
            android:id="@+id/previewLine"
            style="@style/TextAppearance.Fitness.BodyMd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textColor="@color/text_secondary"
            tools:text="Run 20 km between 14 and 20 September." />

        <!-- ============= Submit ============= -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                style="@style/Widget.Fitness.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_goal_submit_create" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/submitProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/text_on_lime"
                app:indicatorSize="22dp"
                app:trackThickness="3dp" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
