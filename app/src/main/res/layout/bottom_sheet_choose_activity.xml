<?xml version="1.0" encoding="utf-8"?>
<!--
  "Log a workout" bottom sheet (phase 8d, LogSheet.dc.html): swipeable
  activity cards, prev / next + dots, the GPS / manual choice (or a note
  for swims and workouts) and one lime button whose label follows the
  selection.

  Padding 12 / 20 / 28dp with 18dp between blocks. The carousel runs
  edge to edge (the design's margin: 0 -20px), so the side margins sit
  on each block instead of on the column. The scroll view only matters
  on very small screens or huge fonts; on a 6.1" phone everything fits.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/logSheetScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/logSheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="@dimen/log_sheet_padding_top"
        android:paddingBottom="@dimen/log_sheet_padding_bottom">

        <View style="@style/Widget.Fitness.SheetHandle" />

        <!-- Title + subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/log_sheet_gap"
            android:orientation="vertical">

            <TextView
                android:id="@+id/logSheetTitle"
                style="@style/TextAppearance.Fitness.SheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_sheet_title" />

            <TextView
                style="@style/TextAppearance.Fitness.SheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/log_sheet_title_gap"
                android:text="@string/log_sheet_subtitle" />
        </LinearLayout>

        <!-- Activity cards, full width so the neighbours peek in. -->
        <com.elijah.fitness.ui.components.ActivityCarouselView
            android:id="@+id/logSheetCarousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/log_sheet_gap" />

        <!-- Previous · dots · next. The 48dp buttons draw a 40dp circle,
             so the gaps above and below are 4dp short of 18dp. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/carousel_nav_row_margin"
            android:layout_marginTop="@dimen/log_sheet_gap_beside_nav"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/logSheetPrevious"
                style="@style/Widget.Fitness.RoundIconButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:contentDescription="@string/log_sheet_previous_content_description"
                android:src="@drawable/ic_chevron_left_24" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.elijah.fitness.ui.components.CarouselDotsView
                android:id="@+id/logSheetDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/logSheetNext"
                style="@style/Widget.Fitness.RoundIconButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:contentDescription="@string/log_sheet_next_content_description"
                android:src="@drawable/ic_chevron_right_24" />
        </LinearLayout>

        <!-- Runs, rides and rows: Live with GPS / Add manually. -->
        <com.elijah.fitness.ui.components.PillSegmentedControl
            android:id="@+id/logSheetModeControl"
            style="@style/Widget.Fitness.PillSegmented.LogSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/log_sheet_gap_beside_nav" />

        <!-- Swims and workouts: one line instead of the choice. Same
             minimum height as the control, so the button doesn't move. -->
        <TextView
            android:id="@+id/logSheetNote"
            style="@style/TextAppearance.Fitness.SheetNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/log_sheet_gap_beside_nav"
            android:gravity="center"
            android:minHeight="@dimen/log_sheet_note_min_height"
            android:visibility="gone"
            tools:text="@string/log_sheet_note_swim" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logSheetCta"
            style="@style/Widget.Fitness.Button.Primary.Large"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_cta_height"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/log_sheet_gap"
            tools:text="@string/log_sheet_cta_run_live" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
