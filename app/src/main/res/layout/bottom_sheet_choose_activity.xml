<?xml version="1.0" encoding="utf-8"?>
<!--
  "Log a workout" bottom sheet (phase 8c step 4). Rebuilt from
  Main.dc.html — one step, three activity tiles + context-sensitive
  options below. Replaces the former two-step chain.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="10dp"
        android:paddingBottom="@dimen/space_xl">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_goal_sheet_handle" />

        <!-- Title + subtitle -->
        <TextView
            style="@style/TextAppearance.Fitness.HeadlineSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/log_sheet_title"
            android:textSize="22sp" />

        <TextView
            style="@style/TextAppearance.Fitness.BodyMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/log_sheet_subtitle"
            android:textColor="@color/text_secondary" />

        <!-- 3-tile activity row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/logSheetActivityRun"
                layout="@layout/view_log_sheet_activity_tile" />

            <Space
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/logSheetActivityRide"
                layout="@layout/view_log_sheet_activity_tile" />

            <Space
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/logSheetActivityLift"
                layout="@layout/view_log_sheet_activity_tile" />
        </LinearLayout>

        <!-- Options eyebrow -->
        <TextView
            style="@style/TextAppearance.Fitness.LabelSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/log_sheet_options_label"
            android:textColor="@color/text_secondary" />

        <!-- Running + Cycling options -->
        <LinearLayout
            android:id="@+id/logSheetDistanceOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/logSheetTrackGps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_log_sheet_option_dark"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_log_sheet_option_icon_lime">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location_pin_24"
                        app:tint="@color/text_on_lime" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Fitness.BodyLg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_sheet_track_gps"
                        android:textColor="@color/text_on_dark"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/log_sheet_track_gps_hint"
                        android:textAllCaps="false"
                        android:textColor="@color/goal_main_muted" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward_24"
                    app:tint="@color/lime_accent" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />

            <LinearLayout
                android:id="@+id/logSheetEnterManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_log_sheet_option_light"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_edit_24"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Fitness.BodyLg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_sheet_manual"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/logSheetManualHint"
                        style="@style/TextAppearance.Fitness.LabelMd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        tools:text="Add a run you have already done" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward_24"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Workout option -->
        <LinearLayout
            android:id="@+id/logSheetLiftOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_log_sheet_option_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="76dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_log_sheet_option_icon_lime">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_list_24"
                    app:tint="@color/text_on_lime" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Fitness.BodyLg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_sheet_lift_option"
                    android:textColor="@color/text_on_dark"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.Fitness.LabelMd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/log_sheet_lift_hint"
                    android:textAllCaps="false"
                    android:textColor="@color/goal_main_muted" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_forward_24"
                app:tint="@color/lime_accent" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
