<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug-only overlay: opts the application into a network security
      config that permits cleartext for the emulator loopback host
      (10.0.2.2) and localhost. Release builds don't apply this file, so
      production traffic stays HTTPS-only.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
